OPENAI_API_KEY=sk-...
# Model rewrite script (theo yêu cầu: gpt-6-luna)
REWRITE_MODEL=gpt-6-luna
# gpt-transcribe: không có timestamp -> service tự cắt câu theo khoảng lặng. whisper-1: dùng timestamp của model
TRANSCRIBE_MODEL=gpt-transcribe

# TikTok Marketing API - lấy reject reason của Smart+ ad
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3

# URL public của service, dùng để build link tải video trả về trong webhook
PUBLIC_BASE_URL=http://localhost:8000
# Secret ký HMAC-SHA256 body webhook (header X-Magician-Signature)
CALLBACK_SECRET=

# --- Bảo mật ---
# Client được phép gọi API: "client_id:secret,client2:secret2" (secret >= 32 ký tự ngẫu nhiên)
API_KEYS=dashboard:CHANGE_ME_random_32+_chars
# true = bắt buộc ký HMAC (khuyến nghị); false = cho phép thêm header X-API-Key: <secret>
REQUIRE_SIGNED_REQUESTS=true
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=2000000
MAX_ITEMS_PER_JOB=50
MAX_ACTIVE_JOBS_PER_CLIENT=5
MAX_VIDEO_MB=300
# Chỉ tải video từ các domain này (suffix match). Để trống = mọi host public
VIDEO_URL_ALLOWLIST=bunnycdn.com,b-cdn.net,tiktokcdn.com,tiktokcdn-us.com,byteoversea.com,ibyteimg.com,bytelemon.com
# Chỉ gửi webhook tới các domain này. Để trống = mọi host public (IP nội bộ luôn bị chặn)
CALLBACK_URL_ALLOWLIST=
ALLOW_HTTP_URLS=false
ALLOW_PRIVATE_URLS=false
# Ký link tải /files (exp + sig). Đặt cố định để link không chết khi restart
FILE_SIGNING_KEY=
FILE_URL_TTL_HOURS=168
ENABLE_DOCS=false

# --- Sửa hình (text trên màn hình, pop-up, cắt đoạn) ---
# Model vision đọc frame + lập kế hoạch sửa
VISION_MODEL=gpt-6-luna
OCR_FPS=2
PLANNER_FPS=1
MAX_PLANNER_FRAMES=60
# Phải cắt quá tỉ lệ này thời lượng video thì coi là không sửa được
MAX_CUT_RATIO=0.35
VIDEO_CRF=18
# Nơi lưu model EasyOCR + LaMa (trống = DATA_DIR/models)
MODELS_DIR=

DATA_DIR=./data
# auto: tự chọn cuda (NVIDIA) / rocm (AMD) / mps (Apple Silicon) / cpu. Có thể ép: cuda, cuda:1, rocm, mps, cpu
DEVICE=auto
# 0 = tự tính theo VRAM/RAM
TTS_WORKERS=0
MAX_TTS_PER_GPU=4
# omnivoice (mặc định) | xtts
TTS_ENGINE=omnivoice
# Python chạy worker TTS (trống = cùng Python với server). XTTS cần env riêng vì transformers<5
OMNIVOICE_PYTHON=
XTTS_PYTHON=
# Mã ngôn ngữ OmniVoice cho tiếng Arab: afb = Gulf/UAE, ars = Najdi/Saudi, arz = Ai Cập, arb = chuẩn
OMNIVOICE_LANG_MAP=ar:afb
OMNIVOICE_NUM_STEP=32
# XTTS-v2 dùng license CPML (non-commercial). Đặt 1 để xác nhận đã đọc license.
COQUI_TOS_AGREED=1
# Giới hạn tăng tốc giọng TTS để vừa khung thời gian cũ
MAX_TEMPO=1.3
# 0 = tự tính (3 x số XTTS worker + 2)
ITEM_CONCURRENCY=0

# --- Vận hành: queue / retry / timeout / dọn dẹp (xem README mục 7, 9) ---
# DB_PATH=./data/magician.db
STAGE_TIMEOUTS=download:180,separate:240,transcribe:240,triage:180,ocr:300,plan:240,rewrite:180,tts:240,render:900,mux:180
TTS_CALL_TIMEOUT=120
DOWNLOAD_CONNECT_TIMEOUT=30
MIN_FREE_GB=5
WORK_RETENTION_HOURS=24
OUTPUT_RETENTION_DAYS=7
JOB_RETENTION_DAYS=30
WEBHOOK_ITEM_EVENTS=true
WEBHOOK_RETRY_DELAYS=10,30,120,300,900,1800
WEBHOOK_TIMEOUT=20
DEDUP_ACTIVE=true
OOM_COOLDOWN_MINUTES=10
# LOG_DIR=./data/logs
LOG_MAX_MB=50
LOG_BACKUPS=10
# auto | blur (mọi chỗ sửa hình đều làm mờ)
VISUAL_METHOD=auto
# Kiểm tra lại video sau khi sửa, sửa thêm 1 lượt nếu còn vi phạm
RECHECK=true
RECHECK_RETRY=true
# Nhãn "AI-generated voice" khi giọng được clone (policy AIGC)
AIGC_OVERLAY=true
